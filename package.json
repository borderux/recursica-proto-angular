{
  "name": "recursica-proto-angular",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "generate": "node scripts/generate-fonts-css.mjs && node scripts/generate-registries.mjs",
    "predev": "npm run generate",
    "dev": "ng serve",
    "prebuild": "npm run generate",
    "build": "npm run format && npm run lint:fix && npm run lint && npm run check-types && ng build",
    "preview": "ng build && serve -s dist/recursica-proto-angular/browser -p 4300",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"**/*.{js,ts,html,json,md,css,scss}\"",
    "format:check": "prettier --check \"**/*.{js,ts,html,json,md,css,scss}\"",
    "check-types": "ngc -p tsconfig.app.json --noEmit",
    "prepare": "node .husky/install.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@recursica/adapter-angular-material": "^0.3.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.37",
    "@angular/cli": "^20.3.37",
    "@angular/compiler-cli": "^20.3.0",
    "@recursica/eslint-plugin": "^0.2.0",
    "@recursica/recursica-postcss-vars": "^1.5.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "20.7.0",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^15.5.2",
    "msw": "^2.15.0",
    "prettier": "3.5.3",
    "serve": "^14.2.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
